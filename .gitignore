# Dependencies
node_modules/
client/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
dist-electron/
release/
build/
client/build/
.vite/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local runtime config — may contain credentials. Never commit.
config/*
!config/README.md
!config/sovereign-streams.example.json
!config/ring-mqtt.example.json

# Database
data/
*.db
*.sqlite
*.sqlite3

# Uploads and temporary files
uploads/
temp/
tmp/

# Storage directory (contains sensitive credentials)
storage/
# Allow README.md in storage for documentation
!storage/README.md

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Playwright test results
test-results/
playwright-report/
.playwright/

# TypeScript cache
*.tsbuildinfo
