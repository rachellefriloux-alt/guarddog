# GuardDog Surveillance System Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Optional - uses in-memory storage by default)
# DATABASE_URL=postgresql://user:password@localhost:5432/guarddog

# AI Detection and Recognition (Recommended for full functionality)
OPENAI_API_KEY=your-openai-api-key-here

# Google Drive Integration (Required for cloud storage)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Security (Optional - auto-generated if not provided)
# SESSION_SECRET=your-session-secret-here
# JWT_SECRET=your-jwt-secret-here

# File Upload Settings
MAX_FILE_SIZE=100
UPLOAD_DIR=./uploads

# Storage Configuration
STORAGE_DIR=./storage
MAX_STORAGE_SIZE=50GB
CLEANUP_OLDER_THAN_DAYS=30

# Recording Settings
RECORDING_QUALITY=high
RECORDING_FORMAT=mp4
MOTION_DETECTION_SENSITIVITY=medium

# Recognition Settings
SIMILARITY_THRESHOLD=0.7
AUTO_LEARN_ENABLED=true
RECOGNITION_CONFIDENCE_MIN=0.8

# Daily Summary Settings
GENERATE_DAILY_SUMMARIES=true
SUMMARY_SCHEDULE_TIME=00:01

# WebSocket Configuration
WS_PORT=5001