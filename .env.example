# GuardDog Surveillance System Environment Configuration
# 
# IMPORTANT: This file contains placeholder values. 
# Copy this file to .env and replace all placeholders with your actual values.
# 
# Quick Start:
#   1. cp .env.example .env
#   2. Edit .env with your actual configuration
#   3. Run: npm run validate-env to check your setup
#
# See QUICKSTART.md for detailed setup instructions
# See SECURITY.md for security best practices

# ============================================================================
# Server Configuration
# ============================================================================
PORT=5000
NODE_ENV=development

# ============================================================================
# Database Configuration (Optional - uses in-memory storage by default)
# ============================================================================
# For production, configure PostgreSQL for persistent storage
# Example: DATABASE_URL=postgresql://username:password@localhost:5432/guarddog
# DATABASE_URL=postgresql://user:password@localhost:5432/guarddog

# ============================================================================
# AI Provider — choose the engine that powers vision / motion analysis
# ============================================================================
# Order of preference when AI_PROVIDER=auto (the default):
#   1. Ollama, if reachable on OLLAMA_HOST          ← free, local, no key
#   2. OpenAI, if OPENAI_API_KEY is set             ← paid, cloud
#   3. Disabled — calls return a clean stub        ← still works, just no AI
#
# Set explicitly to skip auto-detection.
# AI_PROVIDER=auto

# --- Free local AI via Ollama (https://ollama.com) -------------------------
# 1. Install Ollama (one-click installer for Win / macOS / Linux).
# 2. `ollama pull llava` (vision) and `ollama pull llama3.2` (text).
# 3. Done — no key, no quota, no internet needed after model download.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_VISION_MODEL=llava
# OLLAMA_TEXT_MODEL=llama3.2

# ============================================================================
# AI Detection and Recognition (Recommended for full functionality)
# ============================================================================
# Get your API key from https://platform.openai.com/api-keys
# REQUIRED for AI-powered motion detection features
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# Google Drive Integration (Optional - for cloud storage)
# ============================================================================
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# These are separate from the Google Sign-In credentials below
GOOGLE_CLIENT_ID=<your-google-drive-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-drive-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# ============================================================================
# Google Authentication (REQUIRED for GuardDog login)
# ============================================================================
# Create OAuth 2.0 Web Client at: https://console.cloud.google.com/apis/credentials
# You may reuse the Drive client ID above, or create a dedicated Web client ID
# IMPORTANT: Add your redirect URI (http://localhost:5000/auth/google/callback) to authorized redirects
GOOGLE_AUTH_CLIENT_ID=<your-google-sign-in-client-id>

# ============================================================================
# Security (REQUIRED for production)
# ============================================================================
# Generate a secure random string for SESSION_SECRET:
#   openssl rand -base64 32
# NEVER use the default value in production!
SESSION_SECRET=change-me-to-a-secure-random-string-in-production

# ============================================================================
# Frontend Configuration
# ============================================================================
# Usually the same as GOOGLE_AUTH_CLIENT_ID above
VITE_GOOGLE_CLIENT_ID=<your-google-sign-in-client-id>

# ============================================================================
# Google Service Account (Optional - For enhanced Google Drive API access)
# ============================================================================
# Only needed if you're using a Google Service Account for Drive integration
# GOOGLE_SERVICE_ACCOUNT_TOKEN=your-service-account-token-here



# File Upload Settings
MAX_FILE_SIZE=100
UPLOAD_DIR=./uploads

# Storage Configuration
STORAGE_DIR=./storage
MAX_STORAGE_SIZE=50GB
CLEANUP_OLDER_THAN_DAYS=30

# Recording Settings
RECORDING_QUALITY=high
RECORDING_FORMAT=mp4
MOTION_DETECTION_SENSITIVITY=medium

# ============================================================================
# Sovereign Recorder — 24/7 RTSP → cloud-sync MP4 segments
# ============================================================================
# Streams are written as fixed-length MP4 segments (no re-encode) to a folder
# that your cloud client (OneDrive, iCloud, Google Drive desktop, Dropbox, …)
# is already syncing. Each finished segment is uploaded as soon as it's closed
# — no giant in-progress files, no bandwidth spikes.
#
# IMPORTANT: the recorder writes to a LOCAL DISK FOLDER. There is no cloud
# API call in the recording hot path. The desktop sync client (OneDrive.exe /
# Google Drive for Desktop / iCloud) is what uploads finished segments. If the
# internet drops, segments simply queue on disk and upload when the link
# returns — no lost footage.
#
# Override the storage folder. If unset, the recorder auto-detects OneDrive
# (Windows %USERPROFILE%\OneDrive, macOS/Linux ~/OneDrive) and writes to
# <OneDrive>/GuardDog_Surveillance, falling back to STORAGE_DIR/recordings.
# SOVEREIGN_STORAGE_PATH=/Users/me/OneDrive/GuardDog_Surveillance
#
# Path to a JSON file describing the streams to record 24/7. Format:
# [
#   {"name": "Front_Door", "url": "rtsp://127.0.0.1:8554/4c249825f4c8_live"},
#   {"name": "Back_Door",  "url": "rtsp://127.0.0.1:8554/4c24981d7c07_live"},
#   {"name": "eSeeCloud_Main", "url": "rtsp://admin:PASSWORD@10.0.0.50:554/live"}
# ]
# Leave unset to disable the sovereign recorder (existing per-camera streaming
# via the dashboard still works).
# SOVEREIGN_STREAMS_FILE=./config/sovereign-streams.json

# ============================================================================
# MQTT / Frigate events bridge — consume detections from a local AI service
# ============================================================================
# For "AI just like Ring/eSeeCloud" without paying for OpenAI, run Frigate
# (https://frigate.video) or any local CV service that publishes detection
# events to MQTT, and point GuardDog at the broker. Events appear in the
# dashboard alongside cloud-AI detections.
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC=frigate/events

# Recognition Settings
SIMILARITY_THRESHOLD=0.7
AUTO_LEARN_ENABLED=true
RECOGNITION_CONFIDENCE_MIN=0.8

# Daily Summary Settings
GENERATE_DAILY_SUMMARIES=true
SUMMARY_SCHEDULE_TIME=00:01

# ============================================================================
# Free / open-source alternatives
# ============================================================================
# OpenAI is paid and requires internet access. To run AI features for free:
#   - Leave OPENAI_API_KEY unset → AI calls return a disabled-mode response
#     instead of crashing.
#   - Or override the model with a cheaper one: OPENAI_VISION_MODEL=gpt-4o-mini
#   - Or run a local model with Ollama (https://ollama.com) and point a
#     reverse proxy at it; an Ollama-backed adapter is on the roadmap.
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_TEXT_MODEL=gpt-4o-mini

# ============================================================================
# Demo mode
# ============================================================================
# Set to "true" to seed three sample cameras + recent detections + cloud files
# at startup AND to enable a 30s simulated-motion timer for screenshots / demos.
# Real deployments must leave this unset (or "false") so the dashboard reflects
# only real cameras and real detections.
# DEMO_MODE=false
# ============================================================================
# Storage quota
# ============================================================================
# Hard cap (in gigabytes) for the recordings + uploads directories. When the
# total exceeds this value, the cleanup job prunes the oldest files first.
# Useful on laptops where disk space is tight. Snapshots are exempt because
# they're tiny and back the Recordings page thumbnails.
# STORAGE_MAX_GB=50

# ============================================================================
# Notification fan-out
# ============================================================================
# All sinks are optional. Enable any subset; alerts are delivered to every
# enabled sink in parallel.
#
# ntfy.sh — free, open-source push notifications. Create a topic at
#           https://ntfy.sh and paste the topic URL here.
# NTFY_TOPIC_URL=https://ntfy.sh/your-secret-topic
#
# Discord — paste a webhook URL from any channel's integrations page.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
#
# Pushover — set BOTH the user key and the application API token.
# PUSHOVER_USER_KEY=...
# PUSHOVER_API_TOKEN=...
#
# Generic webhook — receives a JSON POST with { title, message, level, meta }.
# Useful for Home Assistant, n8n, Make, custom servers.
# GENERIC_WEBHOOK_URL=https://your-server.example.com/hooks/guarddog

# ============================================================================
# Recording share links
# ============================================================================
# Secret used to sign share-link tokens. Falls back to SESSION_SECRET if unset.
# Generate with: openssl rand -hex 32
# SHARE_LINK_SECRET=

# ============================================================================
# Local AI smart filters
# ============================================================================
# The smart-filter rule generator uses the active AI provider when available
# (Ollama → OpenAI → fallback). Configure either Ollama or OpenAI above to
# enable LLM-powered rule parsing; otherwise a deterministic regex parser
# handles the common cases.
