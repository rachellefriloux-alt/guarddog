# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./data/guarddog.db

# Google Drive API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Ring API (Unofficial)
RING_USERNAME=your_ring_email
RING_PASSWORD=your_ring_password

# ESEE Cloud API
ESEE_API_KEY=your_esee_api_key
ESEE_API_SECRET=your_esee_api_secret

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# AI/ML Configuration
AI_MODEL_ENDPOINT=http://localhost:5000
ENABLE_AI_DETECTION=true

# Camera Configuration
MAX_CAMERAS=16
STREAM_QUALITY=720p
RECORDING_QUALITY=1080p