# GuardDog Surveillance System Environment Configuration
# 
# IMPORTANT: This file contains placeholder values. 
# Copy this file to .env and replace all placeholders with your actual values.
# 
# Quick Start:
#   1. cp .env.example .env
#   2. Edit .env with your actual configuration
#   3. Run: npm run validate-env to check your setup
#
# See QUICKSTART.md for detailed setup instructions
# See SECURITY.md for security best practices

# ============================================================================
# Server Configuration
# ============================================================================
PORT=5000
NODE_ENV=development

# ============================================================================
# Database Configuration (Optional - uses in-memory storage by default)
# ============================================================================
# For production, configure PostgreSQL for persistent storage
# Example: DATABASE_URL=postgresql://username:password@localhost:5432/guarddog
# DATABASE_URL=postgresql://user:password@localhost:5432/guarddog

# ============================================================================
# AI Detection and Recognition (Recommended for full functionality)
# ============================================================================
# Get your API key from https://platform.openai.com/api-keys
# REQUIRED for AI-powered motion detection features
OPENAI_API_KEY=your-openai-api-key-here

# ============================================================================
# Google Drive Integration (Optional - for cloud storage)
# ============================================================================
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
# These are separate from the Google Sign-In credentials below
GOOGLE_CLIENT_ID=<your-google-drive-oauth-client-id>
GOOGLE_CLIENT_SECRET=<your-google-drive-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# ============================================================================
# Google Authentication (REQUIRED for GuardDog login)
# ============================================================================
# Create OAuth 2.0 Web Client at: https://console.cloud.google.com/apis/credentials
# You may reuse the Drive client ID above, or create a dedicated Web client ID
# IMPORTANT: Add your redirect URI (http://localhost:5000/auth/google/callback) to authorized redirects
GOOGLE_AUTH_CLIENT_ID=<your-google-sign-in-client-id>

# ============================================================================
# Security (REQUIRED for production)
# ============================================================================
# Generate a secure random string for SESSION_SECRET:
#   openssl rand -base64 32
# NEVER use the default value in production!
SESSION_SECRET=change-me-to-a-secure-random-string-in-production

# ============================================================================
# Frontend Configuration
# ============================================================================
# Usually the same as GOOGLE_AUTH_CLIENT_ID above
VITE_GOOGLE_CLIENT_ID=<your-google-sign-in-client-id>

# ============================================================================
# Google Service Account (Optional - For enhanced Google Drive API access)
# ============================================================================
# Only needed if you're using a Google Service Account for Drive integration
# GOOGLE_SERVICE_ACCOUNT_TOKEN=your-service-account-token-here



# File Upload Settings
MAX_FILE_SIZE=100
UPLOAD_DIR=./uploads

# Storage Configuration
STORAGE_DIR=./storage
MAX_STORAGE_SIZE=50GB
CLEANUP_OLDER_THAN_DAYS=30

# Recording Settings
RECORDING_QUALITY=high
RECORDING_FORMAT=mp4
MOTION_DETECTION_SENSITIVITY=medium

# Recognition Settings
SIMILARITY_THRESHOLD=0.7
AUTO_LEARN_ENABLED=true
RECOGNITION_CONFIDENCE_MIN=0.8

# Daily Summary Settings
GENERATE_DAILY_SUMMARIES=true
SUMMARY_SCHEDULE_TIME=00:01

# WebSocket Configuration
WS_PORT=5001